# Copia este archivo como .env y completa tu key. Nunca subas .env a git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# 1 = no llamar a la API (textos de plantilla)
OFFLINE=0
# Correo real SOLO para la demo (0 = bandeja simulada). Nunca subas valores reales a git.
MODO_CORREO_REAL=0
# Lista blanca de destinatarios, separados por coma
CORREOS_PERMITIDOS=
# Gmail: usuario y clave de aplicación (no la clave normal de la cuenta)
SMTP_USUARIO=
SMTP_CLAVE_APP=
# Nombre que se inserta localmente en el correo de EST-DEMO (opcional)
NOMBRE_DEMO=
